{
    id = \x.x,
    const = \x.\y.x,
    compose = \f.\g.\x.f (g x),
    zero = \f.\x.x,
    one = \f.\x.f x,
    two = \f.\x.f (f x),
    three = \f.\x.f (f (f x)),
    four = \f.\x.f (f (f (f x))),
    five = \f.\x.f (f (f (f (f x)))),
    succ = \n.\f.\x.f (n f x),
    plus = \m.\n.\f.\x.m f (n f x),
    mult = \m.\n.\f.m (n f),
    pow = \m.\n.n m,
    true = \x.\y.x,
    false = \x.\y.y,
    not = \b.b false true,
    and = \p.\q.p q false,
    or = \p.\q.p true q,
    if = \b.\t.\e.b t e,
    pair = \x.\y.\f.f x y,
    first = \p.p true,
    second = \p.p false,
    twice = \f.\x.f (f x),
}
